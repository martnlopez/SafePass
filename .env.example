# Frontend SafePass · conexión a Supabase
# Copia este archivo como .env.local y completa los valores (Supabase → Project Settings → API).
# .env.local no se sube al repositorio.

# URL del proyecto (ej. https://xxxxxxxxxxxx.supabase.co)
VITE_SUPABASE_URL=

# Clave publicable (sb_publishable_…). Es pública por diseño: la seguridad la dan las reglas RLS
# de la base (supabase/migrations). NUNCA uses aquí la clave secret / service_role.
VITE_SUPABASE_PUBLISHABLE_KEY=
