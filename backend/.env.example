# API SafePass · variables de entorno
# Copia este archivo como .env y completa los valores. .env NO se sube al repositorio.

# ── Servidor ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Detrás de un proxy o balanceador (Render, Cloudflare…), TRUST_PROXY es el número de saltos
# (en Render: 1). Si no, todos los clientes comparten el mismo límite por IP.
TRUST_PROXY=0
JSON_BODY_LIMIT=10kb

# ── CORS ──────────────────────────────────────────────────────────────
# Orígenes (la app) que pueden llamar a la API, separados por coma. En producción, sin "*".
CORS_ORIGINS=http://localhost:5173

# ── Supabase (obligatorio) ────────────────────────────────────────────
# Mismo proyecto que usa la app. Solo la URL y la clave PUBLICABLE (sb_publishable_…): el backend
# actúa con el token de cada usuario, nunca con service_role ni la clave secreta.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Timeout de cada llamada a Supabase (ms)
SUPABASE_TIMEOUT_MS=8000

# ── Límites de tasa (por IP) ──────────────────────────────────────────
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
