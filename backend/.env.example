# ═══════════════════════════════════════════════════════════════════════
#  SafePass API · Variables de entorno
#  1) Copia este archivo:        cp .env.example .env
#  2) Genera los secretos:        npm run keys:generate   (pega el resultado abajo)
#  3) NUNCA subas .env al repositorio (ya está en .gitignore)
# ═══════════════════════════════════════════════════════════════════════

# ── Servidor ───────────────────────────────────────────────────────────
# development | test | production
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Número de proxies/balanceadores delante de la API (0 = conexión directa).
# Necesario para que req.ip y el rate limit usen la IP real del cliente.
TRUST_PROXY=0
# Tamaño máximo del cuerpo JSON
JSON_BODY_LIMIT=10kb

# ── Base de datos (PostgreSQL 14+) ─────────────────────────────────────
# OPCIONAL. Solo la usan las rutas del tótem y del panel HSE. Si la dejas vacía (o la borras),
# esas rutas responden 503 y el servidor atiende solo la API de la app (/api/v1/app), que
# trabaja sobre Supabase: es lo que necesitas para publicar la app.
# Si usas docker-compose.yml, el usuario/clave/BD deben coincidir con las variables POSTGRES_* de abajo.
DATABASE_URL=postgresql://safepass:CAMBIA_ESTA_CLAVE@localhost:5432/safepass?schema=public

# Usadas solo por docker-compose.yml para crear el contenedor de PostgreSQL local
POSTGRES_USER=safepass
POSTGRES_PASSWORD=CAMBIA_ESTA_CLAVE
POSTGRES_DB=safepass
POSTGRES_PORT=5432

# ── CORS ───────────────────────────────────────────────────────────────
# Orígenes permitidos separados por coma (frontend del panel/tótem). En producción es obligatorio y sin "*".
CORS_ORIGINS=http://localhost:5173

# ── JWT ────────────────────────────────────────────────────────────────
# Secreto HS256 de al menos 32 caracteres (npm run keys:generate)
JWT_SECRET=
JWT_ISSUER=safepass-api
JWT_AUDIENCE=safepass-clients
# Duración del token del panel (SUPERVISOR / ADMIN), en segundos (300 – 43200)
JWT_STAFF_TTL_SECONDS=3600
# Duración de la sesión de evaluación en el tótem, en segundos (120 – 1800). Cubre la prueba de ~5 min.
JWT_TOTEM_SESSION_TTL_SECONDS=600

# ── Protección de datos (Ley 19.628 / Ley 21.719) ──────────────────────
# Pepper del PIN (≥ 32 caracteres). Si se pierde, todos los PIN dejan de ser válidos.
PIN_PEPPER=
# AES-256-GCM para RUT y observaciones del supervisor: 32 bytes en base64.
# Si se pierde, los datos cifrados son irrecuperables: respáldala en un gestor de secretos.
FIELD_ENCRYPTION_KEY=
# HMAC-SHA256 para el índice ciego del RUT: 32 bytes en base64, DISTINTA de la anterior.
BLIND_INDEX_KEY=

# ── Reglas de negocio ─────────────────────────────────────────────────
# Intentos fallidos de PIN (sumando todas las IP) antes de bloquear la cuenta, y minutos de bloqueo.
# Umbral alto a propósito: el límite por IP+ficha frena la adivinación, y así un tercero
# no puede dejar bloqueado a otro trabajador con pocos intentos.
LOGIN_MAX_ATTEMPTS=20
LOGIN_LOCKOUT_MINUTES=15
# Descanso preventivo tras un resultado AMARILLO (SEMI-APTO). ROJO no tiene temporizador: decide el supervisor.
RETEST_COOLDOWN_MINUTES=5

# ── Rate limiting ─────────────────────────────────────────────────────
# Ventana en minutos para los límites general y de login
RATE_LIMIT_WINDOW_MINUTES=15
# Peticiones por IP en la ventana, para toda la API
RATE_LIMIT_MAX=300
# Intentos FALLIDOS de login / sesión de tótem por IP en la ventana
RATE_LIMIT_LOGIN_MAX=10
# Intentos FALLIDOS por (IP, ficha) en la ventana
RATE_LIMIT_LOGIN_PER_ACCOUNT_MAX=5
# Detrás de un proxy o balanceador, TRUST_PROXY debe ser el número de saltos;
# si no, todos los clientes comparten el mismo límite por IP.
# Evaluaciones por tótem por minuto
RATE_LIMIT_EVALUATIONS_PER_MINUTE=20

# ── API de la app (/api/v1/app) ───────────────────────────────────────
# Mismo proyecto Supabase que usa el frontend. Solo la URL y la clave PUBLICABLE
# (sb_publishable_…): el backend actúa con el token de cada usuario, nunca con service_role.
# Sin estas dos variables, /api/v1/app responde 503.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Timeout de cada llamada a Supabase (ms)
SUPABASE_TIMEOUT_MS=8000

# ── Seed (npm run db:seed) ────────────────────────────────────────────
# Cuenta ADMIN inicial. El PIN debe tener 6 dígitos y no ser trivial (nada de 123456 / 111111).
SEED_ADMIN_FICHA=ADM-0001
SEED_ADMIN_RUT=
SEED_ADMIN_NAME=
SEED_ADMIN_PIN=
# true = crea cuentas ficticias TRB-0512 (operador), TRB-0513 (supervisora) y TRB-0431 con SEED_DEMO_PIN
SEED_DEMO_WORKERS=false
SEED_DEMO_PIN=
