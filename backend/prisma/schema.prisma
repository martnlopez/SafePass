// SafePass · Esquema de base de datos (PostgreSQL)
//
// Principios de diseño (Ley 19.628 / Ley 21.719 · datos sensibles de salud):
//  - Las evaluaciones NO referencian al trabajador por su id ni por su RUT: usan
//    `subject_id`, un seudónimo UUID v4 aleatorio (workers.pseudonym_id) sin FK.
//    Re-identificar exige acceso a la tabla workers (solo SUPERVISOR / ADMIN).
//  - El RUT se guarda cifrado (AES-256-GCM) + un índice ciego HMAC para unicidad.
//  - Las observaciones del supervisor (pueden contener información de salud) van cifradas.
//  - audit_logs es de solo inserción (trigger en la migración inicial).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OPERATOR
  SUPERVISOR
  ADMIN
}

/// Sistema de turnos de la cuadrilla
enum Crew {
  SHIFT_7X7 @map("7x7")
  SHIFT_4X3 @map("4x3")
}

/// Dictamen semafórico
enum TrafficLight {
  VERDE // Apto (80 – 100 pts)
  AMARILLO // Re-evaluación (60 – 79 pts)
  ROJO // No apto (0 – 59 pts)
}

/// Decisiones disponibles para el supervisor HSE (mismas opciones que el panel web)
enum SupervisorDecision {
  AUTORIZAR_REEVALUACION
  REASIGNACION_TAREA
  DERIVACION_POLICLINICO
  SUSPENSION_TURNO
}

enum AuditActorType {
  STAFF
  TOTEM
  SYSTEM
  ANONYMOUS
}

model Worker {
  id                  String    @id @default(uuid(4)) @db.Uuid
  /// Seudónimo usado en evaluations.subject_id. No se expone por la API.
  pseudonymId         String    @unique @map("pseudonym_id") @db.Uuid
  /// Ficha ID visible en el tótem (ej. TRB-0512)
  fichaId             String    @unique @map("ficha_id") @db.VarChar(8)
  rutEncrypted        String    @map("rut_encrypted")
  /// HMAC-SHA256 del RUT normalizado (índice ciego para unicidad y búsqueda)
  rutHash             String    @unique @map("rut_hash") @db.Char(64)
  fullName            String    @map("full_name") @db.VarChar(120)
  position            String    @db.VarChar(80)
  company             String?   @db.VarChar(120)
  crew                Crew
  role                Role      @default(OPERATOR)
  active              Boolean   @default(true)
  /// Argon2id(HMAC-SHA256(PIN, PIN_PEPPER))
  pinHash             String    @map("pin_hash")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(3)
  deactivatedAt       DateTime? @map("deactivated_at") @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  reviewedEvaluations Evaluation[] @relation("EvaluationReviewedBy")
  voidedEvaluations   Evaluation[] @relation("EvaluationVoidedBy")

  @@index([crew, active])
  @@index([role])
  @@map("workers")
}

/// Tótem / tablet de garita autorizado para enviar evaluaciones
model Totem {
  id         String    @id @default(uuid(4)) @db.Uuid
  name       String    @db.VarChar(80)
  location   String?   @db.VarChar(120)
  /// SHA-256 del secreto del dispositivo (el secreto se muestra una sola vez al crearlo)
  keyHash    String    @map("key_hash") @db.Char(64)
  active     Boolean   @default(true)
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  evaluations Evaluation[]

  @@map("totems")
}

/// Resultado de la prueba neurocognitiva PVT-B
model Evaluation {
  id                      String              @id @default(uuid(4)) @db.Uuid
  /// Seudónimo del trabajador (workers.pseudonym_id). Sin FK a propósito.
  subjectId               String              @map("subject_id") @db.Uuid
  totemId                 String              @map("totem_id") @db.Uuid
  /// jti de la sesión de tótem: una evaluación por sesión (evita reenvíos)
  sessionId               String              @unique @map("session_id") @db.Uuid

  meanLatencyMs           Int                 @map("mean_latency_ms")
  medianReactionTimeMs    Int                 @map("median_reaction_time_ms")
  omissions               Int
  falseStarts             Int                 @map("false_starts")
  totalStimuli            Int                 @map("total_stimuli")
  durationSeconds         Int                 @map("duration_seconds")

  /// Puntaje 0 – 100 calculado en el servidor
  score                   Int
  /// Dictamen del algoritmo (inmutable)
  computedStatus          TrafficLight        @map("computed_status")
  /// Dictamen vigente (el supervisor puede ajustarlo con observación obligatoria)
  status                  TrafficLight
  scoringVersion          String              @map("scoring_version") @db.VarChar(16)

  supervisorDecision      SupervisorDecision? @map("supervisor_decision")
  supervisorNoteEncrypted String?             @map("supervisor_note_encrypted")
  reviewedById            String?             @map("reviewed_by_id") @db.Uuid
  reviewedAt              DateTime?           @map("reviewed_at") @db.Timestamptz(3)

  voidedAt                DateTime?           @map("voided_at") @db.Timestamptz(3)
  voidReason              String?             @map("void_reason") @db.VarChar(500)
  voidedById              String?             @map("voided_by_id") @db.Uuid

  createdAt               DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  totem      Totem   @relation(fields: [totemId], references: [id], onDelete: Restrict)
  reviewedBy Worker? @relation("EvaluationReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  voidedBy   Worker? @relation("EvaluationVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)

  @@index([subjectId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([totemId])
  @@map("evaluations")
}

/// Bitácora de auditoría (solo inserción). Nunca guarda PIN, RUT ni métricas de salud.
model AuditLog {
  id         String         @id @default(uuid(4)) @db.Uuid
  actorType  AuditActorType @map("actor_type")
  /// workers.id (STAFF) o totems.id (TOTEM); null si es anónimo
  actorId    String?        @map("actor_id") @db.Uuid
  action     String         @db.VarChar(64)
  entityType String?        @map("entity_type") @db.VarChar(32)
  entityId   String?        @map("entity_id") @db.VarChar(64)
  metadata   Json?
  ip         String?        @db.VarChar(64)
  userAgent  String?        @map("user_agent") @db.VarChar(256)
  requestId  String?        @map("request_id") @db.VarChar(64)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([action, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}
